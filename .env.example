# FILE: /.env.example
# SplashRecruit Environment Configuration

# Application
APP_NAME="SplashRecruit"
APP_ENV=development
APP_URL=http://localhost
APP_DEBUG=true

# Database
DB_HOST=localhost
DB_NAME=splashrecruit
DB_USER=root
DB_PASS=

# Mail
MAIL_FROM_ADDRESS=noreply@splashrecruit.com
MAIL_FROM_NAME="SplashRecruit"

# Session
SESSION_LIFETIME=7200

# Timezone
APP_TIMEZONE=UTC
